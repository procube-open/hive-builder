<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>8.0</version>
    <template_groups>
        <template_group>
            <uuid>a571c0d144b14fd4a87a9d9b2aa9fcd6</uuid>
            <name>Templates/Applications</name>
        </template_group>
    </template_groups>
    <templates>
        <template>
            <uuid>ce18b099fbd946bda110819d8697b8db</uuid>
            <template>Docker Swarm Services</template>
            <name>Docker Swarm Services</name>
            <description>Template for monitoring Docker Swarm services (CPU, Memory, Replicas)</description>
            <groups>
                <group>
                    <name>Templates/Applications</name>
                </group>
            </groups>
            <discovery_rules>
{% for hive in hive_names %}
                <discovery_rule>
                    <uuid>{{ ('Docker Swarm Services:0:1075c030a70d43ad8fe4baaec26a2378:' + hive) | hash('md5') | regex_replace('^(.{12}).(.{3}).(.*)$', '\\g<1>4\\g<2>8\\g<3>') }}</uuid>
                    <name>Docker Swarm Service Resources Discovery {{ hive }}</name>
                    <key>docker.swarm.service.discovery.{{ hive }}</key>
                    <timeout>30s</timeout>
                    <delay>300</delay>
                    <lifetime>30d</lifetime>
                    <enabled_lifetime_type>DISABLE_NEVER</enabled_lifetime_type>
                    <description>Discover Docker Swarm services running on this node ({{ hive }})</description>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>{{ ('Docker Swarm Services:0:652bdd0018b44fc5b8ffbccc42290704:' + hive) | hash('md5') | regex_replace('^(.{12}).(.{3}).(.*)$', '\\g<1>4\\g<2>8\\g<3>') }}</uuid>
                            <name>Service {{ '{#SERVICE_NAME}' }}: CPU usage ({{ hive }})</name>
                            <key>docker.swarm.service.cpu.{{ hive }}[{{ '{#SERVICE_NAME}' }}]</key>
                            <timeout>30s</timeout>
                            <delay>60</delay>
                            <history>7d</history>
                            <value_type>FLOAT</value_type>
                            <trends>90d</trends>
                            <units>%</units>
                            <description>Average CPU usage percentage for service {{ '{#SERVICE_NAME}' }} ({{ hive }})</description>
                            <tags>
                                <tag>
                                    <tag>Application</tag>
                                    <value>Docker Swarm</value>
                                </tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>{{ ('Docker Swarm Services:0:0611b88a9caf4472b871752e8b7664eb:' + hive) | hash('md5') | regex_replace('^(.{12}).(.{3}).(.*)$', '\\g<1>4\\g<2>8\\g<3>') }}</uuid>
                                    <expression>avg(/Docker Swarm Services/docker.swarm.service.cpu.{{ hive }}[{{ '{#SERVICE_NAME}' }}],5m)&gt;80</expression>
                                    <name>Service {{ '{#SERVICE_NAME}' }}: High CPU usage (over 80% for 5m) ({{ hive }})</name>
                                    <priority>WARNING</priority>
                                    <description>The service {{ '{#SERVICE_NAME}' }} has high CPU usage ({{ hive }})</description>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <uuid>{{ ('Docker Swarm Services:0:f9817311d52e4acd8013a3d6c48aab5f:' + hive) | hash('md5') | regex_replace('^(.{12}).(.{3}).(.*)$', '\\g<1>4\\g<2>8\\g<3>') }}</uuid>
                            <name>Service {{ '{#SERVICE_NAME}' }}: Memory usage ({{ hive }})</name>
                            <key>docker.swarm.service.memory.{{ hive }}[{{ '{#SERVICE_NAME}' }}]</key>
                            <timeout>30s</timeout>
                            <delay>60</delay>
                            <history>7d</history>
                            <trends>90d</trends>
                            <units>B</units>
                            <description>Memory usage in bytes for service {{ '{#SERVICE_NAME}' }} ({{ hive }})</description>
                            <tags>
                                <tag>
                                    <tag>Application</tag>
                                    <value>Docker Swarm</value>
                                </tag>
                            </tags>
                        </item_prototype>
                        <item_prototype>
                            <uuid>{{ ('Docker Swarm Services:0:e66579821aaf435289428104a7c93090:' + hive) | hash('md5') | regex_replace('^(.{12}).(.{3}).(.*)$', '\\g<1>4\\g<2>8\\g<3>') }}</uuid>
                            <name>Service {{ '{#SERVICE_NAME}' }}: Memory limit ({{ hive }})</name>
                            <key>docker.swarm.service.memory.limit.{{ hive }}[{{ '{#SERVICE_NAME}' }}]</key>
                            <timeout>30s</timeout>
                            <delay>300</delay>
                            <history>7d</history>
                            <trends>90d</trends>
                            <units>B</units>
                            <description>Memory limit for service {{ '{#SERVICE_NAME}' }} ({{ hive }})</description>
                            <tags>
                                <tag>
                                    <tag>Application</tag>
                                    <value>Docker Swarm</value>
                                </tag>
                            </tags>
                        </item_prototype>
                        <item_prototype>
                            <uuid>{{ ('Docker Swarm Services:0:ee7bfc3c692e47aca31c955810448b26:' + hive) | hash('md5') | regex_replace('^(.{12}).(.{3}).(.*)$', '\\g<1>4\\g<2>8\\g<3>') }}</uuid>
                            <name>Service {{ '{#SERVICE_NAME}' }}: Memory usage percentage ({{ hive }})</name>
                            <key>docker.swarm.service.memory.percent.{{ hive }}[{{ '{#SERVICE_NAME}' }}]</key>
                            <timeout>30s</timeout>
                            <delay>60</delay>
                            <history>7d</history>
                            <value_type>FLOAT</value_type>
                            <trends>90d</trends>
                            <units>%</units>
                            <description>Memory usage percentage for service {{ '{#SERVICE_NAME}' }} ({{ hive }})</description>
                            <tags>
                                <tag>
                                    <tag>Application</tag>
                                    <value>Docker Swarm</value>
                                </tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>{{ ('Docker Swarm Services:0:73972e7ed6484ed98482d1eed4efcbec:' + hive) | hash('md5') | regex_replace('^(.{12}).(.{3}).(.*)$', '\\g<1>4\\g<2>8\\g<3>') }}</uuid>
                                    <expression>avg(/Docker Swarm Services/docker.swarm.service.memory.percent.{{ hive }}[{{ '{#SERVICE_NAME}' }}],5m)&gt;90</expression>
                                    <name>Service {{ '{#SERVICE_NAME}' }}: High memory usage (over 90% for 5m) ({{ hive }})</name>
                                    <priority>WARNING</priority>
                                    <description>The service {{ '{#SERVICE_NAME}' }} has high memory usage ({{ hive }})</description>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <uuid>{{ ('Docker Swarm Services:0:5b3377b17cc64e9cb274d5572406d194:' + hive) | hash('md5') | regex_replace('^(.{12}).(.{3}).(.*)$', '\\g<1>4\\g<2>8\\g<3>') }}</uuid>
                            <name>Service {{ '{#SERVICE_NAME}' }}: Desired replicas ({{ hive }})</name>
                            <key>docker.swarm.service.replicas.desired.{{ hive }}[{{ '{#SERVICE_NAME}' }}]</key>
                            <timeout>30s</timeout>
                            <delay>60</delay>
                            <history>7d</history>
                            <trends>90d</trends>
                            <description>Desired number of replicas for service {{ '{#SERVICE_NAME}' }} ({{ hive }})</description>
                            <tags>
                                <tag>
                                    <tag>Application</tag>
                                    <value>Docker Swarm</value>
                                </tag>
                            </tags>
                        </item_prototype>
                        <item_prototype>
                            <uuid>{{ ('Docker Swarm Services:0:aed910d1d00c4e35bfd565ec3f608a7c:' + hive) | hash('md5') | regex_replace('^(.{12}).(.{3}).(.*)$', '\\g<1>4\\g<2>8\\g<3>') }}</uuid>
                            <name>Service {{ '{#SERVICE_NAME}' }}: Running replicas ({{ hive }})</name>
                            <key>docker.swarm.service.replicas.running.{{ hive }}[{{ '{#SERVICE_NAME}' }}]</key>
                            <timeout>30s</timeout>
                            <delay>60</delay>
                            <history>7d</history>
                            <trends>90d</trends>
                            <description>Number of running replicas for service {{ '{#SERVICE_NAME}' }} ({{ hive }})</description>
                            <tags>
                                <tag>
                                    <tag>Application</tag>
                                    <value>Docker Swarm</value>
                                </tag>
                            </tags>
                        </item_prototype>
                    </item_prototypes>
                    <trigger_prototypes>
                        <trigger_prototype>
                            <uuid>{{ ('Docker Swarm Services:0:2f09ef4e9bc54ea7968edf200c414d3c:' + hive) | hash('md5') | regex_replace('^(.{12}).(.{3}).(.*)$', '\\g<1>4\\g<2>8\\g<3>') }}</uuid>
                            <expression>last(/Docker Swarm Services/docker.swarm.service.replicas.running.{{ hive }}[{{ '{#SERVICE_NAME}' }}])&lt;last(/Docker Swarm Services/docker.swarm.service.replicas.desired.{{ hive }}[{{ '{#SERVICE_NAME}' }}])</expression>
                            <name>Service {{ '{#SERVICE_NAME}' }}: Replica count mismatch ({{ hive }})</name>
                            <priority>HIGH</priority>
                            <description>The service {{ '{#SERVICE_NAME}' }} has fewer running replicas than desired ({{ hive }})</description>
                        </trigger_prototype>
                    </trigger_prototypes>
                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>{{ ('Docker Swarm Services:0:6c9d095095a0434a9050a5832c8e4633:' + hive) | hash('md5') | regex_replace('^(.{12}).(.{3}).(.*)$', '\\g<1>4\\g<2>8\\g<3>') }}</uuid>
                            <name>Service {{ '{#SERVICE_NAME}' }}: CPU usage ({{ hive }})</name>
                            <graph_items>
                                <graph_item>
                                    <color>1A7C11</color>
                                    <item>
                                        <host>Docker Swarm Services</host>
                                        <key>docker.swarm.service.cpu.{{ hive }}[{{ '{#SERVICE_NAME}' }}]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                        <graph_prototype>
                            <uuid>{{ ('Docker Swarm Services:0:3662ce1c78d14f62b3ee48923c0695e6:' + hive) | hash('md5') | regex_replace('^(.{12}).(.{3}).(.*)$', '\\g<1>4\\g<2>8\\g<3>') }}</uuid>
                            <name>Service {{ '{#SERVICE_NAME}' }}: Memory usage ({{ hive }})</name>
                            <ymin_type_1>FIXED</ymin_type_1>
                            <graph_items>
                                <graph_item>
                                    <color>1A7C11</color>
                                    <item>
                                        <host>Docker Swarm Services</host>
                                        <key>docker.swarm.service.memory.{{ hive }}[{{ '{#SERVICE_NAME}' }}]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <sortorder>1</sortorder>
                                    <color>F63100</color>
                                    <item>
                                        <host>Docker Swarm Services</host>
                                        <key>docker.swarm.service.memory.limit.{{ hive }}[{{ '{#SERVICE_NAME}' }}]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                        <graph_prototype>
                            <uuid>{{ ('Docker Swarm Services:0:678879a6f8ee41bd81f0511dd4c9f5bb:' + hive) | hash('md5') | regex_replace('^(.{12}).(.{3}).(.*)$', '\\g<1>4\\g<2>8\\g<3>') }}</uuid>
                            <name>Service {{ '{#SERVICE_NAME}' }}: Replicas ({{ hive }})</name>
                            <graph_items>
                                <graph_item>
                                    <color>1A7C11</color>
                                    <item>
                                        <host>Docker Swarm Services</host>
                                        <key>docker.swarm.service.replicas.running.{{ hive }}[{{ '{#SERVICE_NAME}' }}]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <sortorder>1</sortorder>
                                    <color>2774A4</color>
                                    <item>
                                        <host>Docker Swarm Services</host>
                                        <key>docker.swarm.service.replicas.desired.{{ hive }}[{{ '{#SERVICE_NAME}' }}]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                </discovery_rule>
{% endfor %}
            </discovery_rules>
        </template>
    </templates>
</zabbix_export>
